# 4: Prime Star Systems
arr=np.array([
    [2,3,5],
    [14,6,8],
    [11,13,17],
    [7,10,13],
])
def is_prime(n):
    if n<2:
        return False
    for i in range(2, int(n**0.5)+1):
        if n % i == 0:
            return False
    return True
def prime_rows(array):
    ndarray=[]
    for row in array:
        if any(is_prime(n) for n in row):
            ndarray.append(row)
    return np.array(ndarray)
result=prime_rows(arr)
print(result)


